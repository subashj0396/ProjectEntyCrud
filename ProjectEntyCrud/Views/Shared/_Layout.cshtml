@using Microsoft.AspNetCore.Http

@{
    Layout = null;

    bool isEmployee = Context.Session.GetInt32("EmpId").HasValue;
    bool isAdmin = !string.IsNullOrEmpty(Context.Session.GetString("AdminName"));
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AttendanceMarkerApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            html, body {
                margin: 0;
                padding: 0;
                min-height: 100%;
                font-family: Arial, sans-serif;
            }

            body {
                padding-top: 65px;
                padding-bottom: 55px;
            }

            /* NAVBAR */

            .app-navbar {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                min-height: 65px;
                background: white;
                z-index: 9999;
                box-shadow: 0 2px 5px rgba(0,0,0,0.15);
            }

                .app-navbar .navbar-brand {
                    color: #0d6efd;
                    font-size: 22px;
                    font-weight: bold;
                }

                .app-navbar .navbar-nav {
                    align-items: center;
                }

                .app-navbar .nav-link {
                    color: #333;
                    font-size: 15px;
                    font-weight: 500;
                    padding: 10px 12px;
                    white-space: nowrap;
                }

                    .app-navbar .nav-link:hover {
                        color: #0d6efd;
                    }

            /* LOGOUT */

            .logout-btn {
                background: #dc3545;
                color: white;
                border: none;
                border-radius: 5px;
                padding: 7px 16px;
                font-weight: 500;
                cursor: pointer;
            }

                .logout-btn:hover {
                    background: #bb2d3b;
                }

            /* MAIN CONTENT */

            .main-content {
                min-height: calc(100vh - 120px);
                padding: 20px;
            }

            /* FOOTER */

            .app-footer {
                position: fixed;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 55px;
                background: #f8f9fa;
                border-top: 1px solid #ddd;
                z-index: 9999;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #555;
            }

                .app-footer p {
                    margin: 0;
                    text-align: center;
                }

            /* MOBILE RESPONSIVE */

            @@media (max-width: 991px) {
                .app-navbar .navbar-collapse {
                    background: white;
                    padding: 10px 15px;
                    border-top: 1px solid #ddd;
                    max-height: calc(100vh - 65px);
                    overflow-y: auto;
                }

                .app-navbar .navbar-nav {
                    align-items: flex-start;
                }

                .app-navbar .nav-link {
                    padding: 10px 0;
                }

                .logout-btn {
                    margin: 8px 0;
                }
            }

            @@media (max-width: 576px) {
                .app-navbar .navbar-brand {
                    font-size: 18px;
                }

                .main-content {
                    padding: 12px;
                }

                .app-footer {
                    font-size: 12px;
                    padding: 5px;
                }
            }
    </style>
</head>

<body>

    <!-- NAVBAR -->

    <header>
        <nav class="navbar navbar-expand-lg navbar-light app-navbar">

            <div class="container-fluid">

                <!-- APPLICATION NAME -->

                <a class="navbar-brand"
                   asp-controller="EmployeeDashboard"
                   asp-action="Login">
                    AttendanceMarkerApp
                </a>

                <!-- MOBILE MENU -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- RIGHT SIDE NAVBAR -->

                <div class="collapse navbar-collapse justify-content-end"
                     id="mainNavbar">

                    <ul class="navbar-nav ms-auto">

                        @if (isEmployee)
                        {
                            <!-- EMPLOYEE NAVBAR -->

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="EmployeeDashboard"
                                   asp-action="DashBoard">
                                    Employee Dashboard
                                </a>
                            </li>

                            <!-- MARK ATTENDANCE -->

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="EmployeeAttendance"
                                   asp-action="Index">
                                    Mark Attendance
                                </a>
                            </li>

                            <!-- MY RECORDS -->

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="EmployeeDashboard"
                                   asp-action="MyRecords">
                                    My Records
                                </a>
                            </li>

                            <!-- EDIT MY RECORD -->

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="EmployeeDashboard"
                                   asp-action="Edit">
                                    Edit My Record
                                </a>
                            </li>

                            <!-- MONTHLY ATTENDANCE -->

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="EmployeeDashboard"
                                   asp-action="MonthlyAttendance">
                                    Monthly Attendance
                                </a>
                            </li>

                            <!-- ATTENDANCE HISTORY -->

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="EmployeeAttendance"
                                   asp-action="History">
                                    Attendance History
                                </a>
                            </li>

                            <!-- EMPLOYEE LOGOUT -->

                            <li class="nav-item">
                                <form asp-controller="EmployeeDashboard"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="logout-btn">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }

                        else if (isAdmin)
                        {
                            <!-- ADMIN NAVBAR -->

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="AdminDashboard"
                                   asp-action="DashBoard">
                                    Admin Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="EmpRecords"
                                   asp-action="Index">
                                    Employee Records
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="AdminDashboard"
                                   asp-action="AttendanceHistory">
                                    Attendance History
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="AdminDashboard"
                                   asp-action="MonthlyReport">
                                    Monthly Attendance Report
                                </a>
                            </li>

                            <!-- ADMIN LOGOUT -->

                            <li class="nav-item">
                                <form asp-controller="AdminLogin"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="logout-btn">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }

                        else
                        {
                            <!-- LOGIN PAGE -->

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="EmployeeDashboard"
                                   asp-action="Login">
                                    Employee Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="AdminLogin"
                                   asp-action="Login">
                                    Admin Login
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN PAGE CONTENT -->

    <div class="main-content">

        <main role="main">
            @RenderBody()
        </main>

    </div>

    <!-- FOOTER -->

    <footer class="app-footer">
        <p>
            &copy; 2026 - AttendanceMarkerApp - All Rights Reserved
        </p>
    </footer>

    <!-- JAVASCRIPT -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
