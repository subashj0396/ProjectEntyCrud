@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5">

    <h2 class="text-primary text-center">
        Admin Dashboard
    </h2>

    <hr />

    <div class="card shadow p-4 mt-4">

        <h4 class="text-success">
            Welcome, @ViewBag.AdminName!
        </h4>

        <p class="text-muted">
            Welcome to the Employee Management System.
        </p>

        <hr />

        <div class="row">

            <!-- Total Employees -->
            <div class="col-md-4">
                <div class="card bg-primary text-white shadow p-4 text-center">

                    <h5>Total Employees</h5>

                    <h1>@ViewBag.TotalEmps</h1>

                    <i class="bi bi-people-fill fs-1"></i>

                </div>
            </div>

        </div>

        <br />

        <!-- Dashboard Buttons -->
        <div class="mt-3">

            <a asp-controller="EmpRecords"
               asp-action="Index"
               class="btn btn-primary mb-2">
                View Employees
            </a>

            <a asp-controller="AdminDashboard"
               asp-action="AttendanceHistory"
               class="btn btn-info text-white mb-2">
                Attendance History
            </a>

            <a asp-controller="AdminDashboard"
               asp-action="MonthlyReport"
               class="btn btn-success mb-2">
                Monthly Attendance Report
            </a>

        </div>

    </div>

</div>
